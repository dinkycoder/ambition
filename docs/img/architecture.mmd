  READER["Readers and builders<br/>embedded wallets, paid briefs"]:::ext
  OPS["You<br/>approvals and reviews"]:::ext

  subgraph AWS["AWS account in us-east-1, deployed only by GitHub Actions through OIDC and CDK in Python"]
