  READER --> ENTRY
  OPS --> SFN
  SFN --> RT
  RT --> MODELS
  RT --> OBS
  RT --> GW
  GW --> GATE --> KMS --> BASE
  GW --> PAY --> CDP
  ENTRY --> CDP
  CDP --> BASE
  GATE --> REC
  OBS -- "sets the kill flag" --> REC
  BASE -. "indexer reads blocks" .-> REC
  REC -. "flag checked first" .-> GW
  REC -. "flag checked first" .-> ENTRY
